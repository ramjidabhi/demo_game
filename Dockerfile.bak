# Generated by universal_docker.py
# syntax=docker/dockerfile:1
FROM python:3.11-slim AS builder
WORKDIR /app
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.docker.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip <<'PYEOF'
#!/usr/bin/env python3
import subprocess, sys, re
res = subprocess.run([sys.executable, '-m', 'pip', 'install', '--default-timeout=100', '--extra-index-url', 'https://mirrors.aliyun.com/pypi/simple/', '-r', 'requirements.txt'])
if res.returncode != 0:
    print('(!) Strict requirements install failed. Retrying with resilient package fallback...')
    skip = {'pywin32', 'pypiwin32', 'windows-curses'}
    for line in open('requirements.txt'):
        r = line.strip()
        if not r or r.startswith('#'): continue
        pkg = re.split(r'[=<>!~]', r)[0].strip()
        if pkg.lower() in skip: continue
        res2 = subprocess.run([sys.executable, '-m', 'pip', 'install', '--default-timeout=100', '--extra-index-url', 'https://mirrors.aliyun.com/pypi/simple/', r])
        if res2.returncode != 0:
            print(f'[!] Exact pin failed for {r}, trying unpinned: {pkg}')
            subprocess.run([sys.executable, '-m', 'pip', 'install', '--default-timeout=100', '--extra-index-url', 'https://mirrors.aliyun.com/pypi/simple/', pkg])
PYEOF

FROM python:3.11-slim AS runtime
WORKDIR /app
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=8000
COPY --from=builder /opt/venv /opt/venv
COPY . .
RUN mkdir -p /app/data && if [ -f game_history.db ]; then cp -n game_history.db /app/data/ 2>/dev/null || true; ln -sf /app/data/game_history.db /app/game_history.db 2>/dev/null || true; fi
RUN printf '#!/usr/bin/env python3\nimport sys, urllib.request as u, urllib.error as e\nport = sys.argv[1] if len(sys.argv) > 1 else "8000"\nfor path in ["/api/health", "/health", "/"]:\n    try:\n        res = u.urlopen(f"http://127.0.0.1:{port}" + path, timeout=3)\n        if res.status < 500: sys.exit(0)\n    except e.HTTPError as ex:\n        if ex.code < 500: sys.exit(0)\n    except Exception: pass\nsys.exit(1)\n' > /app/_health.py && chmod +x /app/_health.py
RUN useradd --create-home --uid 1001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
CMD ["python", "server.py"]
