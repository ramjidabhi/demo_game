# Generated by universal_docker.py
name: demo_game

networks:
  app_net:
    driver: bridge

services:
  web:
    build: .
    image: demo_game_web:latest
    container_name: demo_game_app
    restart: unless-stopped
    networks:
      - app_net
    ports:
      - "${HOST_PORT:-8000}:8000"
    environment:
      - PORT=8000
      - HOST=0.0.0.0
      - SQLITE_PATH=/app/data/game_history.db
      - SQLITE_DATABASE=/app/data/game_history.db
      - DATABASE_URL=sqlite:////app/data/game_history.db
    volumes:
      - sqlite_data:/app/data
    env_file:
      - .env
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2048M
      restart_policy:
        condition: on-failure
        max_attempts: 3
    healthcheck:
      test: ["CMD", "python3", "/app/_health.py", "8000"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 20s


volumes:
  sqlite_data:
